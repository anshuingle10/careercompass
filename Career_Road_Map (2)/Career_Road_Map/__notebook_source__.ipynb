import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix

import warnings
warnings.filterwarnings("ignore")



# Change path according to your Kaggle dataset
df = pd.read_csv("/kaggle/input/college-list/collegelist.csv")

print("Dataset loaded successfully")
print("Shape:", df.shape)
df.head()



# Remove extra spaces and convert column names to lowercase
df.columns = df.columns.str.strip().str.lower()

print("Column names after cleaning:")
print(df.columns)



df.info()



df.describe()



# Check missing values
df.isnull().sum()



# Check duplicate rows
df.duplicated().sum()



# Remove duplicate rows
df.drop_duplicates(inplace=True)

# Check if target column exists
if "admitted" not in df.columns:
    raise ValueError(f"'admitted' column not found. Columns are: {df.columns.tolist()}")

# Ensure target column is integer
df["admitted"] = df["admitted"].astype(int)

print("Data cleaned successfully")
print("New Shape:", df.shape)



X = df.drop("admitted", axis=1)
y = df["admitted"]

print("Feature columns:", X.columns.tolist())
print("Target column: admitted")



label_encoders = {}

for col in X.select_dtypes(include="object").columns:
    le = LabelEncoder()
    X[col] = le.fit_transform(X[col])
    label_encoders[col] = le

print("Categorical encoding completed")
X.head()



scaler = StandardScaler()
X["percentile"] = scaler.fit_transform(X[["percentile"]])

print("Feature scaling completed")
X.head()



X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Training data shape:", X_train.shape)
print("Testing data shape:", X_test.shape)



model = LogisticRegression(max_iter=1000)
model.fit(X_train, y_train)

print("Model trained successfully")



y_pred = model.predict(X_test)
y_pred[:10]



accuracy_score(y_test, y_pred)



classification_report(y_test, y_pred)



confusion_matrix(y_test, y_pred)



y_probability = model.predict_proba(X_test)[:, 1]
y_probability[:10]



print("✅ Admission Prediction Model completed successfully!")



import pickle




with open("admission_model.pkl", "wb") as f:
    pickle.dump(model, f)

print("Model saved as admission_model.pkl")





with open("label_encoders.pkl", "wb") as f:
    pickle.dump(label_encoders, f)

print("Label encoders saved as label_encoders.pkl")



with open("scaler.pkl", "wb") as f:
    pickle.dump(scaler, f)

print("Scaler saved as scaler.pkl")





